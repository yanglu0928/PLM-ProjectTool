{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/poc-03/holdout-dataset.schema.json",
  "title": "POC-03 Human-approved Independent Holdout Dataset",
  "description": "Phase 0 PoC schema. This dataset remains separate from the calibration Golden Dataset and is not a frozen product data model or API contract.",
  "type": "object",
  "required": ["schema_version", "dataset_id", "source_lock", "cases"],
  "properties": {
    "schema_version": {"const": "poc-03.holdout.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_lock": {
      "type": "object",
      "required": ["lock_id", "lock_fingerprint", "source_type_quotas", "isolation"],
      "properties": {
        "lock_id": {"type": "string", "minLength": 1},
        "lock_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_type_quotas": {
          "type": "object",
          "required": ["STANDARD_CAPABILITY", "CONTRACT", "TECHNICAL_AGREEMENT", "SURVEY"],
          "properties": {
            "STANDARD_CAPABILITY": {"const": 33},
            "CONTRACT": {"const": 7},
            "TECHNICAL_AGREEMENT": {"const": 8},
            "SURVEY": {"const": 2}
          },
          "additionalProperties": false
        },
        "isolation": {
          "type": "object",
          "required": ["case_and_query_disjoint", "chunk_id_disjoint", "source_locator_disjoint", "document_disjoint", "document_disjoint_reason"],
          "properties": {
            "case_and_query_disjoint": {"const": true},
            "chunk_id_disjoint": {"const": true},
            "source_locator_disjoint": {"const": true},
            "document_disjoint": {"type": "boolean"},
            "document_disjoint_reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "candidate_id",
          "query",
          "scope",
          "project_id",
          "source_type",
          "evidence_role",
          "expected_classification",
          "expected_relevant_chunk_ids",
          "expected_answer_terms",
          "expected_citations",
          "content_sha256",
          "review"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^HO-[0-9]{4}$"},
          "candidate_id": {"type": "string", "pattern": "^HO-C-[0-9]{4}$"},
          "query": {"type": "string", "minLength": 2},
          "scope": {"const": "PROJECT"},
          "project_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["STANDARD_CAPABILITY", "CONTRACT", "TECHNICAL_AGREEMENT", "SURVEY"]},
          "evidence_role": {"type": "string", "minLength": 1},
          "expected_classification": {"enum": ["STANDARD_SATISFIED", "PARTIALLY_SATISFIED", "NON_STANDARD", "INSUFFICIENT_INFORMATION", "NO_RELIABLE_MATCH"]},
          "expected_relevant_chunk_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "expected_answer_terms": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "expected_citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_id", "chunk_id", "source_locator"],
              "properties": {
                "document_id": {"type": "string", "minLength": 1},
                "chunk_id": {"type": "string", "minLength": 1},
                "source_locator": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "review": {
            "type": "object",
            "required": ["status", "reviewed_by", "reviewed_at"],
            "properties": {
              "status": {"const": "APPROVED"},
              "reviewed_by": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
