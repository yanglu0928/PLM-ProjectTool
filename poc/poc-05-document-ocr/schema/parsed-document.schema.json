{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/poc-05/parsed-document.schema.json",
  "title": "POC-05 ParsedDocument",
  "description": "Phase 0 PoC schema. This is not the frozen product data model or API contract.",
  "type": "object",
  "required": ["schema_version", "source", "title", "pages", "blocks", "metadata", "warnings"],
  "properties": {
    "schema_version": {"const": "poc-05.1"},
    "source": {
      "type": "object",
      "required": ["file_name", "sha256", "media_type", "size_bytes"],
      "properties": {
        "file_name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "title": {"type": ["string", "null"]},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "label", "source_locator"],
        "properties": {
          "number": {"type": ["integer", "null"], "minimum": 1},
          "label": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "text", "page", "section", "table", "source_locator", "metadata"],
        "properties": {
          "id": {"type": "string", "pattern": "^b[0-9]{4,}$"},
          "type": {"enum": ["title", "heading", "paragraph", "table_row", "ocr_line"]},
          "text": {"type": "string", "minLength": 1},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "section": {"type": ["string", "null"]},
          "table": {"type": ["object", "null"]},
          "source_locator": {"type": "string", "minLength": 1},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
